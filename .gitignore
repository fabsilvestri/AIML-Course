.DS_Store
.ipynb_checkpoints/
__pycache__/
*.pyc
notebooks/datasets/

# Titanic/CTA data land here when a notebook is executed from the repo
# root rather than from notebooks/. Same files, different relative path;
# the existing notebooks/datasets/ rule does not cover them.
/datasets/

# Python build artefacts anywhere in the tree
**/__pycache__/

# Written by the Lecture 12 notebook when it is run from notebooks/
notebooks/checkpoints/

# LaTeX intermediates from notes/. The PDFs ARE tracked -- the site links to
# them -- but the .aux/.log/.out/.toc are rebuilt on every run and a 1,600-line
# log in a diff is noise.
notes/*.aux
notes/*.log
notes/*.out
notes/*.toc
notes/*.fls
notes/*.fdb_latexmk
